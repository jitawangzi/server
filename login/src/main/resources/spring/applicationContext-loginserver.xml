<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xmlns:context="http://www.springframework.org/schema/context"
xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
http://www.springframework.org/schema/context
http://www.springframework.org/schema/context/spring-context-3.0.xsd
">
	<!-- 默认配置 -->
	<apollo:config order="10"/>
    <!-- 指示Apollo注入jdbc.properties namespace的配置到Spring环境中，并且顺序在application前面 -->
    <apollo:config namespaces="jdbc" order="11"/>

<!-- <bean id="propertyConfigurer" -->
<!-- 		class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer"> -->
<!-- 		<property name="locations"> -->
<!-- 			<list> -->
<!-- 				<value>classpath:config/login-jdbc.properties</value> -->
<!-- 				<value>classpath:config/loginServer.properties</value> -->
<!-- 			</list> -->
<!-- 		</property> -->
<!-- </bean> -->
    	<!-- myBatis文件 -->
		<bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
			<property name="dataSource" ref="dataSource" />
			<!-- 自动扫描entity目录, 省掉Configuration.xml里的手工配置 -->
			<property name="mapperLocations" value="classpath:mapping/*.xml" />
		</bean>

		<bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
			<property name="basePackage" value="net/login/mapper" />
			<property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />
		</bean>
		
	<context:component-scan base-package="cn.game.net.game.handler" />
	<context:component-scan base-package="cn.game.core.net.socket" />
	<context:component-scan base-package="cn.game.util" />
	
	<bean id="loginGame" class="cn.game.login.net.remote.LoginGameServerInterfaceImpl" >
	</bean>
	
	<bean id="processor" class="cn.game.core.net.process.MultiThreadProcessor">
	</bean>

	<bean id="loginRpcService" class="cn.game.core.net.vertx.rpc.VertxRPCService" destroy-method="shutdown">
		<constructor-arg index="0" type="java.lang.Object" ref="loginGame"></constructor-arg>
		<constructor-arg index="1" type="java.lang.String" value="${login.server.id}"></constructor-arg>
	</bean>
	
	<import resource="applicationContext-dataSource.xml"/>
</beans>
	