<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
	<id>full</id>
	<!-- <appendAssemblyId>false</appendAssemblyId> -->
	<!--这个id会出现在zip包名称的后面，zip的完整名是：pom.xml中的artifactId-version-id.zip -->
	<formats>
		<!--支持的打包格式有zip、tar、tar.gz (or tgz)、tar.bz2 (or tbz2)、jar、dir、war -->
		<format>zip</format>
	</formats>
	<dependencySets>
		<dependencySet>
			<outputDirectory>/lib</outputDirectory>
			<useProjectArtifact>false</useProjectArtifact>
			<scope>runtime</scope>
		</dependencySet>
	</dependencySets>


	<!-- 压缩包下是否生成和包名相同的根目录 -->
	<includeBaseDirectory>false</includeBaseDirectory>
	<!--这里指定需要包含的文件集合 -->
	<fileSets>
		<fileSet>
			<!--Game classes -->
			<outputDirectory>./</outputDirectory> <!--目标位置 -->
			<directory>target/classes</directory><!--源目录 -->
			<includes>
				<include>cn/</include>
			</includes>
		</fileSet>

		<fileSet>
			<!--配置文件 -->
			<outputDirectory>./resources</outputDirectory> <!--目标位置 -->
			<directory>../build/${game.server}/game/resources</directory><!--源目录 -->
		</fileSet>

		<fileSet>
			<!--  xml  -->
			<outputDirectory>./resources</outputDirectory> <!--目标位置 -->
			<directory>src/main/resources</directory><!--源目录 -->
			<excludes>
				<exclude>apollo/</exclude>
                <exclude>config/</exclude>
            </excludes>
		</fileSet>


	</fileSets>
	<files>
		<!-- 单个文件 -->
		<!-- <file> -->
		<!-- <source>target/xxx.txt</source> -->
		<!-- <outputDirectory>/</outputDirectory> -->
		<!-- </file> -->
	</files>

</assembly>