      		</timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>

        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%msg time[%d{yyyy-MM-dd HH:mm:ss.SSS}]thread[%thread]level[%-5level]logger[%logger{20}]%n</pattern>
        </layout>
    </appender>  
	<logger name="recvLog" additivity="false">
		<level value="info"></level>
		<appender-ref ref="async_recvfile" />
	</logger>
	<logger name="recvslowLog" additivity="false">
		<level value="info"></level>
		<appender-ref ref="async_recvslowfile" />
	</logger>
	<logger name="sendLog" additivity="false">
		<level value="info"></level>
		<appender-ref ref="async_sendfile" />
	</logger>
	<logger name="threadpoolLog" additivity="false">
		<level value="DEBUG"></level>
		<appender-ref ref="async_threadpoolfile" />
	</logger>	
	<logger name="dbLog" additivity="false">
		<level value="INFO"></level>
		<appender-ref ref="dbfile" />
	</logger>
	<logger name="maintenanceLog" additivity="false">
		<level value="INFO"></level>
		<appender-ref ref="maintenancefile" />
	</logger>
	<logger name="sun.rmi" additivity="false">
		<level value="INFO" />
		<appender-ref ref="rmiLog"/>
	</logger>
	<logger name="minaLog" additivity="false">
		<level value="error"></level>
		<appender-ref ref="async_minafile" />
	</logger>		
    <root level="error">
        <appender-ref ref="stdout" />
        <appender-ref ref="defaultLog" />
    	<appender-ref ref="FILE-ERROR" /> 
    </root>
</configuration>