	<groupId>cn.game</groupId>
	<artifactId>server</artifactId>
	<version>1.0</version>
	<packaging>pom</packaging>
	<modules>
		<module>../util</module>
		<module>../protocol</module>
		<module>../core</module>
		<module>../game</module>
		<module>../login</module>
	</modules>

	<url>http://maven.apache.org</url>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<skipTests>true</skipTests>
		
	    <!-- 内部模块版本 -->
	    <util.version>${project.version}</util.version>
	    <protocol.version>${project.version}</protocol.version>
	    <core.version>${project.version}</core.version>
	    <game.version>${project.version}</game.version>
	    <login.version>${project.version}</login.version>
		
		<!-- 第三方依赖版本 -->
		<vertx.version>4.2.1</vertx.version>
		<spring.version>5.3.32</spring.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.0</version>
				<!--				<configuration>-->
				<!--					<release>17</release>-->
				<!--				</configuration>-->
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>2.5</version>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.6.0</version>
				<executions>
					<execution>
						<id>get-git-commit-hash</id>
						<phase>initialize</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>git</executable>
							<arguments>
								<argument>log</argument>
								<argument>-n</argument>
								<argument>1</argument>
								<argument>--pretty=format:%H</argument>
							</arguments>
							<outputFile>
								${project.build.directory}/classes/version.txt</outputFile>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- 这里先不启用这个插件，容易提示出错，需要的时候在打开 -->
			<!-- 
				<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				</plugin>
 -->
		</plugins>

		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself.-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.codehaus.mojo
										</groupId>
										<artifactId>
											exec-maven-plugin
										</artifactId>
										<versionRange>
											[1.6.0,)
										</versionRange>
										<goals>
											<goal>exec</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<executions>
						<execution>
							<id>copy-dependencies</id>
							<phase>package</phase>
							<goals>
								<goal>copy-dependencies</goal>
							</goals>
							<configuration>
								<!-- 拷贝项目依赖包到lib/目录下 -->
								<outputDirectory>${project.build.directory}/lib</outputDirectory>
								<!-- 间接依赖也拷贝 -->
								<excludeTransitive>false</excludeTransitive>
								<!-- 带上版本号 -->
								<stripVersion>false</stripVersion>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	
